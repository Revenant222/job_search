# Required for service account
GOOGLE_USE_SERVICE_ACCOUNT=true
GOOGLE_SERVICE_ACCOUNT_PATH=config/service_account_credentials.json  # Optional - this is the default anyway

# Google API Configuration
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly

# Application Configuration
LOG_LEVEL=INFO
DEBUG_MODE=False

# Web Scraping Configuration
REQUEST_TIMEOUT=8
MAX_RETRIES=3
RETRY_DELAY=1.5

# Fuzzy Matching Thresholds
FUZZY_TITLE_THRESHOLD=85
FUZZY_SKILLS_THRESHOLD=70
FUZZY_GEOGRAPHY_THRESHOLD=80 